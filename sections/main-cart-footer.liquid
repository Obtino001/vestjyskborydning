{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="gradient color-{{ section.settings.color_scheme }}{% if cart == empty %} is-empty{% endif %}"
  id="main-cart-footer"
  data-id="{{ section.id }}"
>
  <div class="page-width">
    <div class="cart__footer isolate section-{{ section.id }}-padding">
      {%- if settings.show_cart_note -%}
        <cart-note class="cart__note field">
          <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
          <textarea
            class="text-area field__input"
            name="note"
            form="cart"
            id="Cart-note"
            placeholder="{{ 'sections.cart.note' | t }}"
          >{{ cart.note }}</textarea>
        </cart-note>
      {%- endif -%}

      <div class="cart__blocks">
        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'subtotal' -%}
              <div class="js-contents" {{ block.shopify_attributes }}>
                {%- liquid
                  assign has_bundle_discount = false
                  assign effective_discount = cart.total_discount
                  assign effective_total = cart.total_price
                  if cart.item_count >= 3
                    assign has_bundle_discount = true
                    if effective_discount == 0
                      assign effective_discount = 40000
                      assign effective_total = cart.total_price | minus: 40000 | at_least: 0
                    endif
                  elsif cart.total_discount > 0
                    assign has_bundle_discount = true
                  endif
                -%}
                {%- if has_bundle_discount -%}
                  <div class="totals totals--discount" role="status">
                    <span class="totals__discount-label">Rabat (3+ numre)</span>
                    <span class="totals__discount-value">-{{ effective_discount | money_with_currency }}</span>
                  </div>
                {%- endif -%}

                <div class="totals">
                  <h2 class="totals__total">Total</h2>
                  <p class="totals__total-value">
                    {%- if has_bundle_discount -%}
                      <s class="totals__original-value">{{ cart.original_total_price | money_with_currency }}</s>
                    {%- endif -%}
                    <span>{{ effective_total | money_with_currency }}</span>
                  </p>
                </div>

                {%- render 'cart-info-list' -%}
              </div>
            {%- else -%}
              <div class="cart__ctas" {{ block.shopify_attributes }}>
                {%- if cart.item_count >= 3 and settings.cart_bundle_discount_code != blank -%}
                  <input type="hidden" name="discount" value="{{ settings.cart_bundle_discount_code | escape }}" form="cart">
                {%- endif -%}
                <button
                  type="submit"
                  id="checkout"
                  class="cart__checkout-button button"
                  name="checkout"
                  {% if cart == empty %}
                    disabled
                  {% endif %}
                  form="cart"
                >
                  {{ 'sections.cart.checkout' | t }}
                </button>
              </div>

              {%- comment -%} Express checkout buttons removed on request; payment icons shown instead. {%- endcomment -%}
              {%- render 'payment-icons', class: 'list-payment--compact' -%}
          {%- endcase -%}
        {% endfor %}

        <div id="cart-errors"></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },    
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
